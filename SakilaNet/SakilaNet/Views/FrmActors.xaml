<UserControl x:Class="SakilaNet.Views.FrmActors" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SakilaNet.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- StackPanel arriba -->
            <RowDefinition Height="*"/>     <!-- DataGrid abajo -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Agregar" Click="AddActor" Margin="5"/>
            <Button Content="Editar" Click="EditActor" Margin="5"/>
            <Button Content="Eliminar" Click="DeleteActor" Margin="5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgActors" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ActorId}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding FirstName}" Width="*" />
                <DataGridTextColumn Header="Apellido" Binding="{Binding LastName}" Width="*" />
                <DataGridTextColumn Header="Actualización" Width="150"
                                    Binding="{Binding LastUpdate, StringFormat='dd/MM/yyyy HH:mm:ss'}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>