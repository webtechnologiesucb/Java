<Window x:Class="SakilaNet.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="400" Height="200" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <Border CornerRadius="10" Background="White" Padding="20" BorderBrush="Gray" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Cargando SakilaNet..." FontSize="20" FontWeight="Bold" Margin="10" />
            <ProgressBar IsIndeterminate="True" Height="20" Margin="10"/>
        </StackPanel>
    </Border>
</Window>

