<Window x:Class="SakilaNet.Views.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="220" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <Label HorizontalAlignment="Center" FontWeight="Bold">INGRESO A SAKILA APP</Label>
        <TextBox x:Name="txtUsername" Margin="0,10"/>
        <PasswordBox x:Name="txtPassword" Margin="0,10"/>
        <Button Content="Ingresar" Click="Login_Click" Margin="0,10"/>
    </StackPanel>
</Window>
