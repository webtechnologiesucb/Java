<Window x:Class="SakilaNet.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actor" Height="200" Width="300">
    <StackPanel Margin="10">
        <Label Content="Nombre:"/>
        <TextBox x:Name="txtFirstName" Margin="5"/>
        <Label Content="Apellido:"/>
        <TextBox x:Name="txtLastName" Margin="5"/>
        <Button Content="Aceptar" Click="Accept" Margin="5" HorizontalAlignment="Right" Width="75"/>
    </StackPanel>
</Window>